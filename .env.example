# Precision Oligos agent platform - example configuration.
# Copy to .env for local development. Never commit real secrets.

# --- Environment identity (per AWS naming standard: <customer>-<project>-<env>) ---
ENVID=acme-oligos-dev
AWS_REGION=eu-west-1
LOGGER_LEVEL=INFO

# --- Bedrock models (region-pinned inference profiles; no cross-region global.*) ---
# Cheap/fast model for routing + extraction; stronger model for drafting.
ROUTER_MODEL=bedrock:eu.anthropic.claude-3-5-haiku-20241022-v1:0
EXTRACTION_MODEL=bedrock:eu.anthropic.claude-3-5-haiku-20241022-v1:0
DRAFTING_MODEL=bedrock:eu.anthropic.claude-sonnet-5
# Optional Bedrock Guardrail applied to untrusted retrieved content.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# --- Knowledge base (consumed by id; not provisioned by this project) ---
KNOWLEDGE_BASE_ID=
KNOWLEDGE_BASE_REGION=eu-west-1
# Optional cross-account access to the KB.
KB_ASSUME_ROLE_ARN=
KB_ASSUME_ROLE_EXTERNAL_ID=

# --- Storage ---
RUNS_TABLE=RunsDdbTable-eu-west-1-acme-oligos-dev
AUDIT_TABLE=AuditDdbTable-eu-west-1-acme-oligos-dev
SESSIONS_TABLE=SessionsDdbTable-eu-west-1-acme-oligos-dev
AUDIT_WORM_BUCKET=

# --- Orchestration ---
STATE_MACHINE_ARN=

# --- Tracing / observability data lake (pydantic-ai OTel via Logfire) ---
SERVICE_VERSION=0.1.0
# Kinesis Firehose delivery stream that lands OTel spans in the S3 data lake.
# Leave blank to disable the data-lake sink.
OTEL_FIREHOSE_STREAM=
# Capture prompt/response content in spans (may include sensitive retrieved
# documents). Off by default.
OTEL_CAPTURE_CONTENT=false
# Optional Logfire live platform. Provide a token directly, or a Secrets
# Manager ARN to resolve it at runtime. When set, spans also go to Logfire.
LOGFIRE_TOKEN=
LOGFIRE_TOKEN_SECRET_ARN=

# --- Notifications ---
NOTIFICATIONS_TOPIC_ARN=

# --- LIMS (thin, configurable REST client) ---
LIMS_BASE_URL=
LIMS_API_KEY_SECRET_ARN=
LIMS_TIMEOUT_SECONDS=15

# --- Authentication (Cognito federated to Entra SAML; BFF pattern) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET_ARN=
COGNITO_DOMAIN=
COGNITO_REGION=eu-west-1
# Public base URL of the app (CloudFront domain) used for OIDC redirect URIs.
PUBLIC_BASE_URL=http://localhost:8000
SESSION_COOKIE_NAME=oligos_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=28800
# Signing key for the CSRF token / cookie (from Secrets Manager in production).
SESSION_SIGNING_SECRET=change-me-in-production

# --- Remote MCP server (OAuth 2.1, MCP authorization spec 2025-06-18) ---
# Serve the OAuth-protected MCP server + its authorization server from the API.
MCP_ENABLED=true
# DynamoDB table backing the OAuth server (clients, codes, tokens). In-memory
# fallback is used when unset (local dev).
MCP_OAUTH_TABLE=
# Space-separated scopes advertised and required for the MCP resource.
MCP_SCOPES=oligos:use
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_REFRESH_TOKEN_TTL_SECONDS=1209600
MCP_CODE_TTL_SECONDS=300

# --- Local development convenience ---
# When true, auth is bypassed with a fake local user (never enable in AWS).
# Also makes the MCP OAuth /authorize skip Cognito and go straight to consent.
LOCAL_AUTH_BYPASS=false
